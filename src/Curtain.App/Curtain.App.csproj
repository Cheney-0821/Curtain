<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Curtain.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Curtain.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version Condition="'$(Version)' == ''">0.3.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">0.3.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <CurtainDistributionKind Condition="'$(CurtainDistributionKind)' == ''">Development</CurtainDistributionKind>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CurtainTestSettings)' == 'true'">
    <DefineConstants>$(DefineConstants);CURTAIN_TEST_SETTINGS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../release/diagnostic-version-map.json" LogicalName="Curtain.ReleaseVersionMap" />
    <Content Include="Assets\Curtain.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Curtain.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Services\Curtain.EtwWatchdog.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7175" />
    <ProjectReference Include="../Curtain.Core/Curtain.Core.csproj" />
  </ItemGroup>
  <Target Name="CurtainBuildIdentity" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="CurtainGitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="CurtainGitExit" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=normal" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="CurtainGitStatus" />
      <Output TaskParameter="ExitCode" PropertyName="CurtainStatusExit" />
    </Exec>
    <PropertyGroup>
      <CurtainGitCommit Condition="'$(CurtainGitExit)' != '0'">Unknown</CurtainGitCommit>
      <CurtainDirty>false</CurtainDirty>
      <CurtainDirty Condition="'$(CurtainGitStatus)' != ''">true</CurtainDirty>
      <CurtainDirty Condition="'$(CurtainStatusExit)' != '0'">Unknown</CurtainDirty>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="GitCommit" Value="$(CurtainGitCommit)" />
      <AssemblyMetadata Include="BuildId" Value="$([System.Guid]::NewGuid().ToString('N'))" />
      <AssemblyMetadata Include="BuildTimestampUtc" Value="$([System.DateTime]::UtcNow.ToString('O'))" />
      <AssemblyMetadata Include="WorkingTreeDirty" Value="$(CurtainDirty)" />
      <AssemblyMetadata Include="DistributionKind" Value="$(CurtainDistributionKind)" />
    </ItemGroup>
  </Target>
</Project>
