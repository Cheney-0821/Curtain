<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="using:CommunityToolkit.WinUI.Controls" xmlns:curtain="using:Curtain.App.Controls" xmlns:pages="using:Curtain.App.Pages" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Curtain.App.MainWindow">
    <Grid>
        <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="LeftCompact" SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,6,0,8">
                    <Image Source="ms-appx:///Assets/Curtain.png" Width="24" Height="24" />
                    <TextBlock Text="Curtain" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsItem" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.Content>
                <Grid x:Name="PageHost" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <Grid x:Name="HomePage" Visibility="Visible">
                        <ScrollViewer x:Name="HomeScrollHost" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Padding="24,20,24,24" Spacing="16" MaxWidth="1064">
                                <TextBlock x:Name="HomeTitleText" Style="{StaticResource TitleTextBlockStyle}" />
                                <curtain:ScrollAwareSettingsExpander>
                                    <curtain:ScrollAwareSettingsExpander.Header>
                                        <TextBlock x:Name="AddWindowTitleText" Style="{StaticResource BodyTextBlockStyle}" />
                                    </curtain:ScrollAwareSettingsExpander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="PickButton" Click="OnPickClick" />
                                        <Button x:Name="ScreenPrivacyButton" Click="OnScreenPrivacyClick" />
                                        <Button x:Name="ResumeAutoButton" Click="OnResumeAutoClick" Visibility="Collapsed" />
                                    </StackPanel>
                                    <curtain:ScrollAwareSettingsExpander.Description>
                                        <TextBlock x:Name="AddWindowHintText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                    </curtain:ScrollAwareSettingsExpander.Description>
                                    <curtain:ScrollAwareSettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="" FontSize="20" />
                                    </curtain:ScrollAwareSettingsExpander.HeaderIcon>
                                    <curtain:ScrollAwareSettingsExpander.Items>
                                        <controls:SettingsCard>
                                            <controls:SettingsCard.Header>
                                                <TextBlock x:Name="HotkeyEnabledLabelText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                            </controls:SettingsCard.Header>
                                            <controls:SettingsCard.Description>
                                                <StackPanel Spacing="4">
                                                    <TextBlock x:Name="HotkeyHintText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="HotkeyStatusText" TextWrapping="Wrap" Opacity="0.75" />
                                                </StackPanel>
                                            </controls:SettingsCard.Description>
                                            <controls:SettingsCard.HeaderIcon>
                                                <FontIcon Glyph="" FontSize="20" />
                                            </controls:SettingsCard.HeaderIcon>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <StackPanel x:Name="HotkeyCapsHost" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
                                                <Button x:Name="EditHotkeyButton" Click="OnEditHotkey" Padding="6" MinWidth="32">
                                                    <FontIcon Glyph="" FontSize="14" />
                                                </Button>
                                            </StackPanel>
                                        </controls:SettingsCard>
                                        <controls:SettingsCard>
                                            <controls:SettingsCard.Header>
                                                <TextBlock x:Name="PrivacyHotkeyLabelText" TextWrapping="Wrap" />
                                            </controls:SettingsCard.Header>
                                            <controls:SettingsCard.Description>
                                                <StackPanel Spacing="4">
                                                    <TextBlock x:Name="ScreenHotkeyHintText" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="PrivacyHotkeyStatusText" TextWrapping="Wrap" Visibility="Collapsed" />
                                                </StackPanel>
                                            </controls:SettingsCard.Description>
                                            <controls:SettingsCard.HeaderIcon>
                                                <FontIcon Glyph="" FontSize="20" />
                                            </controls:SettingsCard.HeaderIcon>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <StackPanel x:Name="PrivacyHotkeyCapsHost" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
                                                <Button x:Name="EditPrivacyHotkeyButton" Click="OnEditPrivacyHotkey" Padding="6" MinWidth="32">
                                                    <FontIcon Glyph="" FontSize="14" />
                                                </Button>
                                            </StackPanel>
                                        </controls:SettingsCard>
                                        <controls:SettingsCard>
                                            <controls:SettingsCard.Header>
                                                <TextBlock x:Name="PrivacyMouseLabelText" TextWrapping="Wrap" />
                                            </controls:SettingsCard.Header>
                                            <controls:SettingsCard.Description>
                                                <TextBlock x:Name="PrivacyMouseHintText" TextWrapping="Wrap" />
                                            </controls:SettingsCard.Description>
                                            <controls:SettingsCard.HeaderIcon>
                                                <FontIcon Glyph="&#xE962;" FontSize="20" />
                                            </controls:SettingsCard.HeaderIcon>
                                            <ComboBox x:Name="PrivacyMouseCombo" Width="170" HorizontalAlignment="Right" SelectionChanged="OnPrivacyMouseChanged">
                                                <ComboBoxItem />
                                                <ComboBoxItem />
                                                <ComboBoxItem />
                                            </ComboBox>
                                        </controls:SettingsCard>
                                    </curtain:ScrollAwareSettingsExpander.Items>
                                </curtain:ScrollAwareSettingsExpander>
                                <StackPanel x:Name="GlobalProtectionHost" Spacing="6" />
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="CountText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="EmptyText" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.7" />
                                        </StackPanel>
                                        <MenuBar Grid.Column="1" VerticalAlignment="Center">
                                            <MenuBarItem x:Name="BulkActionsItem">
                                                <MenuFlyoutItem x:Name="ProtectAllMenuItem" Click="OnProtectAll" />
                                                <MenuFlyoutItem x:Name="PauseAllMenuItem" Click="OnPauseAll" />
                                            </MenuBarItem>
                                        </MenuBar>
                                    </Grid>
                                    <ListView x:Name="WindowList" SelectionMode="None" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="320">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <curtain:ScrollAwareSettingsExpander Tag="{Binding}" Loaded="OnWindowSettingsLoaded" Margin="0,0,0,4" HorizontalContentAlignment="Stretch">
                                                    <curtain:ScrollAwareSettingsExpander.Header>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </curtain:ScrollAwareSettingsExpander.Header>
                                                    <curtain:ScrollAwareSettingsExpander.Description>
                                                        <TextBlock Text="{Binding State}" Opacity="0.7" />
                                                    </curtain:ScrollAwareSettingsExpander.Description>
                                                    <curtain:ScrollAwareSettingsExpander.HeaderIcon>
                                                        <PathIcon Width="20" Height="20" Data="F0 M0,2 L20,2 L20,18 L0,18 Z M1.5,6 L18.5,6 L18.5,16.5 L1.5,16.5 Z" />
                                                    </curtain:ScrollAwareSettingsExpander.HeaderIcon>
                                                    <Button Tag="{Binding}" Click="OnRowDetach" Loaded="OnRemoveButtonLoaded" />
                                                </curtain:ScrollAwareSettingsExpander>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="RememberedAppsTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="RememberedAppsDescriptionText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Opacity="0.75" />
                                    <ListView x:Name="RememberedAppsList" SelectionMode="None" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="200">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="12" Padding="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding State}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Tag="{Binding RuleId}" Click="OnRemoveRememberedAppClick" Loaded="OnRememberedAppRemoveButtonLoaded" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="CandidateText" Visibility="Collapsed" TextWrapping="Wrap" Opacity="0.7" />
                                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.7" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <curtain:ScrollAwareSettingsExpander>
                                        <curtain:ScrollAwareSettingsExpander.Header>
                                            <TextBlock x:Name="AutoProtectionTitleText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                        </curtain:ScrollAwareSettingsExpander.Header>
                                        <curtain:ScrollAwareSettingsExpander.Description>
                                            <TextBlock x:Name="IdleProtectHintText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                        </curtain:ScrollAwareSettingsExpander.Description>
                                        <curtain:ScrollAwareSettingsExpander.HeaderIcon>
                                            <PathIcon Width="20" Height="20" Data="F0 M10,0 A10,10 0 1 1 10,20 A10,10 0 1 1 10,0 Z M10,1.5 A8.5,8.5 0 1 1 10,18.5 A8.5,8.5 0 1 1 10,1.5 Z M9.25,4 L10.75,4 L10.75,9.25 L15,9.25 L15,10.75 L9.25,10.75 Z" />
                                        </curtain:ScrollAwareSettingsExpander.HeaderIcon>
                                        <ToggleSwitch x:Name="IdleProtectSwitch" MinWidth="0" Toggled="OnAutoProtectionChanged" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        <curtain:ScrollAwareSettingsExpander.Items>
                                            <controls:SettingsCard>
                                                <controls:SettingsCard.Header>
                                                    <TextBlock x:Name="IdleMinutesLabelText" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </controls:SettingsCard.Header>
                                                <ComboBox x:Name="IdleMinutesCombo" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="136" SelectedValuePath="Tag" SelectionChanged="OnAutoProtectionScopeChanged">
                                                    <ComboBoxItem Tag="1" />
                                                    <ComboBoxItem Tag="3" />
                                                    <ComboBoxItem Tag="5" />
                                                    <ComboBoxItem Tag="10" />
                                                </ComboBox>
                                                <controls:SettingsCard.Description>
                                                    <TextBlock x:Name="IdleMinutesHintText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                                </controls:SettingsCard.Description>
                                                <controls:SettingsCard.HeaderIcon>
                                                    <PathIcon Width="20" Height="20" Data="F0 M10,0 A10,10 0 1 1 10,20 A10,10 0 1 1 10,0 Z M10,1.5 A8.5,8.5 0 1 1 10,18.5 A8.5,8.5 0 1 1 10,1.5 Z M9.25,4 L10.75,4 L10.75,9.25 L15,9.25 L15,10.75 L9.25,10.75 Z" />
                                                </controls:SettingsCard.HeaderIcon>
                                            </controls:SettingsCard>
                                            <controls:SettingsCard>
                                                <controls:SettingsCard.Header>
                                                    <TextBlock x:Name="AutoProtectionScopeLabelText" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </controls:SettingsCard.Header>
                                                <ComboBox x:Name="IdleScopeCombo" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="OnAutoProtectionScopeChanged" Width="220" />
                                                <controls:SettingsCard.Description>
                                                    <TextBlock x:Name="IdleScopeHintText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                                </controls:SettingsCard.Description>
                                                <controls:SettingsCard.HeaderIcon>
                                                    <FontIcon Glyph="" FontSize="20" />
                                                </controls:SettingsCard.HeaderIcon>
                                            </controls:SettingsCard>
                                        </curtain:ScrollAwareSettingsExpander.Items>
                                    </curtain:ScrollAwareSettingsExpander>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Grid x:Name="SettingsPage" Visibility="Collapsed">
                        <ScrollViewer>
                            <StackPanel Padding="24,20,24,24" Spacing="20" MaxWidth="1064">
                                <TextBlock x:Name="SettingsTitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="ms-appx:///Assets/Curtain.png" Width="88" Height="88" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="Curtain" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock x:Name="AboutDescriptionText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <HyperlinkButton x:Name="GithubLink" NavigateUri="https://github.com/Cheney-0821/Curtain" Content="GitHub" Padding="0" />
                                            <HyperlinkButton x:Name="WebsiteLink" NavigateUri="https://curtain.cheneylab.cn/" Padding="0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="UpdatesTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <curtain:ScrollAwareSettingsExpander>
                                        <curtain:ScrollAwareSettingsExpander.Header>
                                            <TextBlock x:Name="AppVersionText" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </curtain:ScrollAwareSettingsExpander.Header>
                                        <curtain:ScrollAwareSettingsExpander.Description>
                                            <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Opacity="0.7" />
                                        </curtain:ScrollAwareSettingsExpander.Description>
                                        <curtain:ScrollAwareSettingsExpander.HeaderIcon>
                                            <FontIcon Glyph="" FontSize="20" />
                                        </curtain:ScrollAwareSettingsExpander.HeaderIcon>
                                        <Button x:Name="UpdateActionButton" Click="OnUpdateActionClick" />
                                        <curtain:ScrollAwareSettingsExpander.Items>
                                            <controls:SettingsCard>
                                                <controls:SettingsCard.Header>
                                                    <CheckBox x:Name="AutoUpdateCheck" Checked="OnAutoUpdateToggled" Unchecked="OnAutoUpdateToggled">
                                                        <TextBlock x:Name="AutoUpdateLabelText" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </CheckBox>
                                                </controls:SettingsCard.Header>
                                                <controls:SettingsCard.Description>
                                                    <TextBlock x:Name="AutoUpdateHintText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="32,0,0,0" />
                                                </controls:SettingsCard.Description>
                                            </controls:SettingsCard>
                                        </curtain:ScrollAwareSettingsExpander.Items>
                                    </curtain:ScrollAwareSettingsExpander>
                                    <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="4" Visibility="Collapsed" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="GeneralTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <controls:SettingsCard>
                                        <controls:SettingsCard.Header>
                                            <TextBlock x:Name="StartupLabelText" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </controls:SettingsCard.Header>
                                        <ToggleSwitch x:Name="StartupSwitch" MinWidth="0" Toggled="OnStartupToggled" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        <controls:SettingsCard.Description>
                                            <TextBlock x:Name="StartupHintText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                        </controls:SettingsCard.Description>
                                        <controls:SettingsCard.HeaderIcon>
                                            <FontIcon Glyph="" FontSize="20" />
                                        </controls:SettingsCard.HeaderIcon>
                                    </controls:SettingsCard>
                                    <controls:SettingsCard>
                                        <controls:SettingsCard.Header>
                                            <TextBlock x:Name="LanguageLabelText" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </controls:SettingsCard.Header>
                                        <ComboBox x:Name="LanguageCombo" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="136" SelectedValuePath="Tag" SelectionChanged="OnLanguageSelectionChanged">
                                            <ComboBoxItem Tag="System" />
                                            <ComboBoxItem Tag="en-US" />
                                            <ComboBoxItem Tag="zh-CN" />
                                        </ComboBox>
                                        <controls:SettingsCard.Description>
                                            <TextBlock x:Name="LanguageHintText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                        </controls:SettingsCard.Description>
                                        <controls:SettingsCard.HeaderIcon>
                                            <FontIcon Glyph="" FontSize="20" />
                                        </controls:SettingsCard.HeaderIcon>
                                    </controls:SettingsCard>
                                </StackPanel>
                                <pages:DiagnosticsPage x:Name="DiagnosticsPageControl" />
                                <TextBlock x:Name="SettingsStatusText" Style="{StaticResource BodyTextBlockStyle}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
