<UserControl
    x:Class="Curtain.App.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:curtain="using:Curtain.App.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
    <StackPanel Spacing="4" HorizontalAlignment="Stretch">
        <TextBlock x:Name="PageTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
        <curtain:ScrollAwareSettingsExpander>
            <curtain:ScrollAwareSettingsExpander.Header><TextBlock x:Name="RecordingTitleText" /></curtain:ScrollAwareSettingsExpander.Header>
            <curtain:ScrollAwareSettingsExpander.Description><TextBlock x:Name="RecordingDescriptionText" TextWrapping="Wrap" /></curtain:ScrollAwareSettingsExpander.Description>
            <curtain:ScrollAwareSettingsExpander.HeaderIcon><FontIcon Glyph="&#xE9D9;" FontSize="20" /></curtain:ScrollAwareSettingsExpander.HeaderIcon>
            <ToggleSwitch x:Name="RecordingSwitch" MinWidth="0" Toggled="OnRecordingToggled" />
            <curtain:ScrollAwareSettingsExpander.Items>
                <controls:SettingsCard>
                    <controls:SettingsCard.Header><CheckBox x:Name="IncludeRawEtwCheckBox" Checked="OnRawEtwChanged" Unchecked="OnRawEtwChanged" /></controls:SettingsCard.Header>
                    <controls:SettingsCard.Description>
                        <StackPanel Margin="32,0,0,0" Spacing="4">
                            <TextBlock x:Name="RawEtwDescriptionText" TextWrapping="Wrap" />
                            <HyperlinkButton x:Name="OpenLogsFolderButton" Click="OnOpenLogsFolderClick" Padding="0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </controls:SettingsCard.Description>
                </controls:SettingsCard>
            </curtain:ScrollAwareSettingsExpander.Items>
        </curtain:ScrollAwareSettingsExpander>
        <controls:SettingsCard>
            <controls:SettingsCard.Header><TextBlock x:Name="FeedbackTitleText" /></controls:SettingsCard.Header>
            <controls:SettingsCard.Description><TextBlock x:Name="FeedbackDescriptionText" TextWrapping="Wrap" /></controls:SettingsCard.Description>
            <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8F2;" FontSize="20" /></controls:SettingsCard.HeaderIcon>
            <Button x:Name="OpenFeedbackButton" Click="OnOpenFeedbackClick" />
        </controls:SettingsCard>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,4,0,0" />
    </StackPanel>
    <ContentDialog x:Name="FeedbackDialog" DefaultButton="Primary"
                   PrimaryButtonClick="OnSubmitFeedbackClick" SecondaryButtonClick="OnCopyFeedbackIdClick"
                   Closing="OnFeedbackDialogClosing">
        <StackPanel Spacing="16" Width="408" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="BundleTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="BundleDescriptionText" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="GenerateBundleButton" Click="OnGenerateBundleClick" />
                    <Button x:Name="ViewBundleButton" Click="OnViewBundleClick" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
            <TextBox x:Name="FeedbackIssueTextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="88" MaxLength="300" />
            <TextBox x:Name="FeedbackEmailTextBox" MaxLength="254" />
            <CheckBox x:Name="FeedbackConsentCheckBox" Checked="OnFeedbackConsentChanged"
                      Unchecked="OnFeedbackConsentChanged" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <TextBlock x:Name="FeedbackConsentText" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock x:Name="FeedbackStatusText" TextWrapping="Wrap" />
        </StackPanel>
    </ContentDialog>
    </Grid>
</UserControl>
